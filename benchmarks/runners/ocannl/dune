; The runners' JSON scalars and result line, a library rather than a module of the executables so
; that test/operations/bench_result_line can link it without the whole framework (gh-ocannl-676).
(library
 (name bench_json)
 ; Attached to a package (though never installed) because its dependants are: a private library
 ; assigned to a package may not depend on an unpackaged one, and test/operations/bench_result_line
 ; is `(package neural_nets_lib)`.
 (package neural_nets_lib)
 (modules bench_json)
 (libraries base))

(executables
 (names
  bench_mlp
  bench_conv
  bench_gpt
  bench_gpt_diag
  bench_conv_diag
  bench_min_repro)
 (modules
  bench_mlp
  bench_conv
  bench_gpt
  bench_gpt_diag
  bench_conv_diag
  bench_min_repro
  bench_harness)
 (libraries base bench_json ocannl stdio unix mtime mtime.clock.os)
 (preprocess
  (pps ppx_here ppx_ocannl))
 (modes exe))

(executable
 (name bench_metal_bug)
 (modules bench_metal_bug)
 (libraries metal ctypes)
 (enabled_if
  (= %{system} macosx))
 (modes exe))
