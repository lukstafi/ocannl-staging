; The vendor arms of the test and tool executables' `select`s, compiled as libraries against the
; stand-ins (`arrayjit/vendor_stubs/dune` describes the arrangement; gh-ocannl-1688). Each such
; executable picks its `*.real.ml` / `*.cudajit.ml` / `*.hipjit.ml` / `*.metal.ml` arm only where
; the vendor library is installed and a stub everywhere else, so `@check` off the vendor's box
; compiled only the stub. Here every arm is copied under the module name its executable gives it
; and compiled, one library per executable, with that executable's libraries and preprocessing --
; the vendor packages replaced by their stand-ins, and the vendor backends by the `typecheck/`
; copies one directory over. An executable whose arm reaches no vendor module at all (the
; `test/operations` arms, which drive the backend through `Context`) needs no stand-in: its copy
; compiles against `ocannl` alone. Nothing links these libraries.
;
; A library compiles an arm slightly more permissively than its executable: a top-level value no
; module uses is an error in an executable (dune gives its modules an empty interface) and silent
; here, so a dead binding still surfaces only on the box.

; arrayjit/test: test_cuda_classify_failure

(rule
 (action
  (copy#
   ../../test/test_cuda_classify_failure.real.ml
   test_cuda_classify_failure.ml)))

(library
 (name test_cuda_classify_failure_arm)
 (modules test_cuda_classify_failure)
 (libraries base stdio cudajit_stub cuda_backend_stub_check arrayjit.ir))

; arrayjit/test: test_hip_compile_failure_options, with the claims module its executable carries.

(copy_files#
 (files ../../test/hip_compile_failure_options_claims.ml))

(rule
 (action
  (copy#
   ../../test/test_hip_compile_failure_options.real.ml
   test_hip_compile_failure_options.ml)))

(library
 (name test_hip_compile_failure_options_arm)
 (modules
  test_hip_compile_failure_options
  hip_compile_failure_options_claims)
 (libraries
  base
  stdio
  arrayjit.utils
  arrayjit.verdict
  hipjit_stub
  hip_backend_stub_check
  arrayjit.ir))

