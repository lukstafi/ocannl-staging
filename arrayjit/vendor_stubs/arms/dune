; tools: fp8_soak, the shared program with both of its arms, so that each arm is checked against
; the signature fp8_soak.ml packs it under, not only on its own.

(copy_files#
 (files ../../../tools/fp8_soak.ml))

(rule
 (action
  (copy# ../../../tools/fp8_soak_cuda.cudajit.ml fp8_soak_cuda.ml)))

(rule
 (action
  (copy# ../../../tools/fp8_soak_hip.hipjit.ml fp8_soak_hip.ml)))

(library
 (name fp8_soak_arms)
 (modules fp8_soak fp8_soak_cuda fp8_soak_hip)
 (libraries
  base
  stdio
  unix
  arrayjit.ir
  arrayjit.verdict
  cudajit_stub
  cuda_backend_stub_check
  hipjit_stub
  hip_backend_stub_check))

