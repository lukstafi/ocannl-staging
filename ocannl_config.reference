# This file lists all the current configurations. It can be used as documentation
# or as a template for writing `ocannl_config` files. The `ocannl_` prefix is optional
# everywhere: commandline arguments accept both `--ocannl_<name>=<value>` and
# `--<name>=<value>`; environment variables still require the `OCANNL_` prefix (to
# avoid conflicts with other tools); in `ocannl_config` files the prefix has always
# been optional. The names are case-insensitive. The values are case-sensitive and
# should be lowercase where case is irrelevant. The configuration is read from a few
# sources, from highest priority:
# 1. Commandline arguments.
# 2. Environment variables.
# 3. `ocannl_config` files.
# 4. Defaults hard-coded at use sites in the source code.
#
# Only one `ocannl_config` file is used per run, searched for in the current directory
# and in ancestor directories. Unless `log_config_sourcing` is false, the source of the
# `log_level` config is always printed, and the sources of other configs are printed
# when the log level > 0.
# The configuration values below are (one of) the defaults.
#
# Repeating fields are disallowed. If the value is an empty string, the default value
# is used (as if the config was not present).

# Bootstrap configurations (read before the config file search begins):

# If true, suppresses the "Welcome to OCANNL!" startup message.
suppress_welcome_message=false

# If true, disables reading any ocannl_config file; only commandline and environment
# variable configuration is used.
no_config_file=false

# If true, prints where each configuration setting comes from (commandline, environment,
# config file, or the hard-coded default): always for `log_level`, and for the remaining
# settings when the log level > 0. Set to false to keep the output clean, e.g. in tests;
# re-enable it (also for a single run, via `--ocannl_log_config_sourcing=true`) to debug
# which configuration a run actually picks up.
log_config_sourcing=true

# Configurations that are stored as `Utils.settings`:

# The log level, for ppx_minidebug and with a few other uses in OCANNL.
log_level=1

# If `log_level` is at least 2 and this is true, the generated code will contain
# printf statements, whose output is then (typically) integrated into ppx_minidebug logs.
debug_log_from_routines=false

# If true, various intermediate representation files for the compiled code are generated
# (or not removed). Moreover, if log level is at least 2, the generated binaries will
# contain debug symbols for debugging with `gdb`, `cuda-gdb` etc.
output_debug_files_in_build_directory=false

# If true, when printing Low_level.t values in human-readable syntax (.ll files),
# tensor node names will include their precision annotations (e.g., `n3<single>` instead of `n3`).
# This is useful for debugging precision-related issues in generated code.
output_prec_in_ll_files=false

# If given, the integer seed to initialize the randomness library with.
fixed_state_for_init=

# For printing tensors, etc.
print_decimals_precision=2

# Complains if a half-precision tensor node is a constant with absolute value exceeding this.
check_half_prec_constants_cutoff=16384.0

# The default variant of threefry4x32 PRNG to use. Options: "crypto" (20 rounds) or
# "light" (2 rounds). Defaults to "light" for better performance.
default_prng_variant=light

# If true, use int64 for indexing arithmetic. If false (default), use int32 for indexing arithmetic
# (signed since docs/proposals/signed-index-precision.md; unsigned precisions remain for data
# domains). This affects all backends' kernel index parameters and local index variables, and the
# Metal pool offset width (which stays unsigned: uint vs ulong). Set to true for models with
# tensors/pools larger than 2^31 elements / 2^32 bytes; with the default, each tensor node's padded
# element count must fit int32 (enforced with an error when the node's dimensions are resolved).
large_models=false

# Deprecated alias for large_models (its pre-gh-ocannl-344 name): read as a fallback only when
# large_models is unset, so existing configs / CLI / OCANNL_BIG_MODELS keep working.
big_models=false

# Generated code files are placed in build_files/<prefix>/, and diagnostic / routine-debug
# logs in log_files/<prefix>/. When unset (the default), the prefix is derived from the
# executable's base name, so concurrently running programs sharing a working directory
# (e.g. parallel dune tests) never collide on same-named kernels. Set to a non-empty value
# to pick the subdirectory explicitly, or to the special value "." for the flat legacy
# layout (files directly in build_files/ and log_files/).
build_files_prefix=

# If true, the build_files/<prefix>/ subdirectory of this process (see build_files_prefix)
# is deleted on startup; the whole build_files/ directory when the prefix is ".".
clean_up_build_files_on_startup=true

# If true, the log_files/<prefix>/ subdirectory of this process (see build_files_prefix)
# is deleted on startup; the whole log_files/ directory when the prefix is ".".
clean_up_log_files_on_startup=true

# Other configurations:

# The default backend for computations, if `Backends.fresh_backend` isn't passed `backend_name`.
# Available: cc, multidev_cc, cuda, hip, metal.
backend=cc

# The number of devices the multidev_cc backend exposes (each is a worker domain with its own
# FIFO queue, for debugging multi-device parallel workflows on CPU); 0 means the domain count
# recommended for this machine. Fixed at first use of the backend.
multidev_num_devices=0

# If true, on GPU backends (cuda, hip, metal) kernels compiled without an explicit `lowered_transform`
# get the default GPU schedule (docs/proposals/schedule-ir-optops.md §6): parallelizable loops are
# annotated / split into Grid x Workgroup pairs when a conservative analysis proves the kernel
# race-free under the annotation; otherwise the kernel runs single-threaded as before. Disabled
# automatically while `debug_log_from_routines` is active (to keep kernel logs serial).
automatic_gpu_schedule=true

# The workgroup (threadgroup, block) size the default GPU schedule targets: single parallel loops
# are split by this factor; a second parallelizable loop is used as the Workgroup axis directly
# when its extent fits. The configured value is a target: the annotator clamps it to the backend's
# max-threads-per-workgroup device limit (minimum across devices on multi-device backends).
gpu_schedule_block_size=256

# Kernels whose largest parallelizable loop nest has fewer than this many parallel iterations are
# left unscheduled by the default GPU schedule. The default is low (64): a kernel launches either
# way, so any real parallelism beats the serial 1x1 fallback (a single GPU thread is 1-2 orders
# of magnitude slower than a CPU core). Sub-simdgroup-scale kernels stay serial so that tiny
# programs' segments coalesce back to a single kernel with unchanged placements. Raise this to
# keep more kernels serial, e.g. to make their generated code easier to read.
gpu_schedule_min_parallel=64

# If true, on CPU backends (cc, multidev_cc) kernels compiled without an explicit
# `lowered_transform` get the default CPU schedule: the same conservative analysis as the GPU
# schedule, retyping each nest's outermost parallelizable loop to Grid, which the C backend
# renders as chunked parallel loops on a native thread pool (see `cc_parallel_grid`). Disabled
# automatically while `debug_log_from_routines` is active.
automatic_cpu_schedule=true

# Kernels whose largest parallelizable loop nest has fewer than this many parallel iterations are
# left unscheduled by the default CPU schedule (task fan-out overhead would dominate).
cpu_schedule_min_parallel=16384

# If true (and the automatic schedule for the backend is active), routines are split into multiple
# kernels at cross-workgroup dependency edges — sibling top-level statements whose
# producer/consumer (or WAW/WAR) pairing over a materialized node the default annotator's race
# analysis would otherwise reject, plus bare materialized writes and whole-node zeroing. The
# segment kernels launch in order on the routine's stream with a device-side event chained at
# each boundary (providing the grid-wide synchronization threads within one launch lack) and each
# segment is scheduled on its own launch geometry. Adjacent segments that end up serial are coalesced, so an all-serial
# routine still compiles to a single kernel. If false, such routines compile to one kernel and run
# serially whenever the analysis bails, as before.
schedule_fission=true

# If true, backend compilation logs one stderr line per compiled kernel/segment with its launch
# grid/block dimensions and statement count — for diffing what two compiles of nominally
# identical code actually emit. Debugging aid; independent of the ppx_minidebug log levels.
schedule_log_launches=false

# Liveness-based buffer aliasing (the memory planner, gh-ocannl-489). If true, a routine's
# working (non-constant, freshly allocated) tensor-node buffers are laid out in one arena where
# nodes with disjoint live ranges — computed over the routine's final kernel sequence — may share
# bytes, shrinking the routine's device-memory footprint. Only unobservable intermediates that the
# routine writes before reading are eligible; parameters, host-initialized, recurrent, constant
# and observable nodes always keep dedicated bytes. Contract: an aliased node's values are NOT
# preserved past its last read within the routine — reading one from the host or from a
# later-compiled routine raises a User_error (mark the node observable before compiling, or
# disable this setting). Most effective when the whole training step compiles as one routine
# (e.g. Train.grad_update + sgd_update sequenced into a single compilation). Also sinks each
# whole-node zeroing to just before the node's first update (values unchanged), so the gradients
# zeroed up-front by Train.grad_update get liveness-disjoint spans across the backprop chain
# instead of all starting at the zero-grads block.
buffer_aliasing=false

# If true, linking a liveness-planned routine logs one stderr line with the working pool's arena
# size vs. the dedicated (bump-packed) size and how many nodes were liveness-planned — the
# footprint report accompanying buffer_aliasing. Debugging aid, schedule_log_launches-style.
log_buffer_aliasing=false

# If true, code generation logs one stderr line per declined rendering, naming the kernel, the
# construct, and the rule that failed: a Grid loop that fails pool-parallel eligibility (an
# ineligible local and which of the shared/privatization rules it broke, or the per-chunk
# footprint cap), and a Tile_mma statement that falls back from the intrinsic or register-tiled
# rendering (the failed rule plus the statement's precisions, extents, transposition flags and
# operand address spaces). Declines are silent by design — the fallback is correct — but
# indistinguishable from the intended rendering in timings; this is the "why did my schedule
# render serial/scalar" switch for hand schedules and autotune runs.
schedule_log_declines=false

# gh-494: run the legacy procedural schedule-legality analyses alongside the affine conflict
# queries (arrayjit/lib/affine.ml) that replaced them, and compare. A query stricter than the
# procedural answer raises (a query precision regression, or a latent unsoundness of the procedural
# rule); a query more permissive than the procedural answer is the expected precision gain, logged
# to stderr. A debugging/soak switch: off by default, no effect on behavior beyond the comparison.
legality_crosscheck=false

# How the C backend renders eligible outermost Grid loops (pool-backed Grid rendering,
# docs/proposals/gh-ocannl-164.md): "dispatch" uses libdispatch's dispatch_apply (macOS),
# "openmp" uses `#pragma omp parallel for` (adds -fopenmp to the kernel compile), "none" keeps
# serial loops, "auto" (default) probes what the configured compiler accepts. Both runtimes own a
# single process-global thread pool; worker threads run pure C and never touch the OCaml runtime.
# Applies to explicitly annotated (schedule-transformed) kernels as well as the automatic
# schedule; results are bitwise identical to serial execution (grid iterations write disjoint
# elements).
cc_parallel_grid=auto

# Target chunk count for parallel Grid rendering; the actual count is capped by the loop extent.
# 0 (default) means automatic: 4 x the recommended domain count (core count).
cc_parallel_chunks=0

# Byte cap on the combined footprint of the per-chunk privatized tiles of one pool-parallel Grid
# loop (block-scope arrays living on the pool workers' stacks; see the privatization rule in
# c_syntax.ml's parallel_grid_safe). A loop whose privatized locals exceed the cap renders serial
# instead (log with schedule_log_declines). The default, 262144 (256KB), leaves headroom under
# libdispatch's default 512KB worker stacks; raise it when the pool's worker stacks are known
# larger (e.g. under OMP_STACKSIZE with the OpenMP rendering) — for instance to let a
# grid-outermost packed GEMM re-pack a whole B~ panel per chunk. Values <= 0 fall back to the
# default.
cc_grid_private_bytes_cap=262144

# Vector register width in bytes for explicit SIMD rendering of Vectorized-typed loops in the C
# backends (GCC/Clang vector extensions): eligible loop bodies emit vector loads/arithmetic/stores
# in width/element-size lanes plus a serial remainder, instead of relying on the compiler's
# auto-vectorizer (which e.g. cannot reassociate strict-FP reductions -- the Vectorized retype
# carries that permission, like schedule Swap). A recognized accumulation body
# (acc = op(acc, contrib(i)), op one of + * max min, or the FMA form) renders as independent
# vector accumulator chains with a horizontal reduce at loop exit (ggml's vec_dot pattern).
# Unset or -1 means automatic: 32 when the SIMD probe finds AVX2, else 16 (NEON). 0 disables
# explicit emission (pragma-hinted auto-vectorization remains). Ineligible bodies
# (non-elementwise, non-contiguous, cross-lane flow) keep the pragma rendering; ineligible
# ACCUMULATING bodies fall back to a plain serial loop instead (the pragmas would assert
# iteration independence).
cc_vector_bytes=-1

# The beam width of `Autotune.tune`'s empirical schedule search: how many of the fastest
# candidates each round expands with further schedule ops.
autotune_beam_width=2

# The maximum number of beam-expansion rounds beyond the seed candidates (the serial baseline and
# the default-annotator block-size sweep). The search also stops when a round improves the best
# time by less than 1%.
autotune_rounds=2

# Timed runs per tuning candidate (after one warmup run); the minimum is kept.
autotune_repeats=3

# Directory of the autotuner's schedule disk cache, keyed by the canonical digest of the
# optimized code and the backend name. Relative paths resolve against the working directory.
# An empty value disables the cache (every `Autotune.tune` call searches afresh).
autotune_cache_dir=autotune_cache

# If true, `Autotune.tune` logs each candidate to stderr: its spec, whether it failed (with the
# error message), deduplicated against an already-seen post-schedule digest, or was timed (and
# its time), plus the cache-hit, winner-replay and fallback outcomes. For debugging search
# quality; independent of the ppx_minidebug log levels.
autotune_log=false

# The analytic-cost-model pre-filter of `Autotune.tune`'s sketch seeding (gh-ocannl-491): per
# candidate family (the whole-routine sketches; each fission segment's sketches), candidates are
# ranked by the roofline model and only the best `autotune_keep_fraction` of the model-scored
# ones are compiled and timed. 1 disables the pre-filter. Candidates without model coverage —
# opaque code, a schedule the model cannot apply, missing envelope constants — are never
# dropped, only measured, so the model never overrides (or precludes) a measured result and the
# outcome is independent of enumeration order. Presets, saved schedules and the serial baseline
# are never pruned.
autotune_keep_fraction=1

# When non-empty, `Autotune.tune` appends one tab-separated calibration row per timed candidate
# to this file: backend, digest tag, candidate label, measured ms, model-roofline ms (empty when
# the model cannot score the candidate), kernel count, flops, bytes, opaque flag. The flops and
# bytes columns aggregate over the candidate's kernels while the model column sums per-kernel
# roofline bounds, so fitting the envelope constants from aggregates is exact only for rows with
# kernel count 1. Every tuning run is free model-vs-measured divergence data for fitting the
# envelope constants (see model_peak_flops).
# Relative paths resolve against the working directory. With autotune_log=true the same
# calibration lines also go to stderr, human-readable.
autotune_calibration_file=

# If true, untuned compiles issued by the recipes (`Train.to_routine`, `Train.run_once` and its
# wrappers, the benchmark runners' untuned arms) pick the default schedule with the analytic
# cost model (`Autotune.model_default`, gh-ocannl-491): the untuned default pipeline and the
# sketch families are scored with the roofline model and the best is applied — zero timing runs,
# one backend compile. Advisory: requires envelope constants (the backend's advisory values or
# the model_peak_* overrides below), ties go to the default pipeline, and any scoring or
# application failure falls back to it.
model_default_schedule=false

# Overrides the backend's advisory peak arithmetic throughput, in FLOP/s (single precision, FMA
# counted as two operations), used as the compute leg of the analytic cost model's roofline
# envelope. Calibrated per-machine values (fit from autotune_calibration_file data) beat the
# backends' class-level constants; unset/empty uses the backend's value (the C backends provide
# none, so scoring on them requires setting this and/or model_peak_memory_bandwidth).
model_peak_flops=

# Overrides the backend's advisory peak main-memory bandwidth, in bytes/s — the memory leg of
# the roofline envelope. Same contract as model_peak_flops.
model_peak_memory_bandwidth=

# If true, stdout capturing is disabled, so some logs meant for the ppx_minidebug log files
# (in particular CUDA logs) remain on the stdout.
#
# NOTE: current implementation of stdout capture loses information on channel
# buffering overflows, so it is important to verify with this setting if one gets
# sufficient information in the logs files.
never_capture_stdout=false

# If `false`, debug logs from routines are re-logged via the ppx_minidebug framework.
# If `true`, the logs are in stream-specific files. WARNING: files are appended to, not overwritten.
debug_log_to_stream_files=false

# If set and relevant, it's the `CU_LIMIT_PRINTF_FIFO_SIZE` CUDA configuration.
cuda_printf_fifo_size=

# If set and relevant, it's the `hipLimitPrintfFifoSize` HIP configuration.
hip_printf_fifo_size=

# The `-O` argument to the compiler executable for the `cc` and `multidev_cc` backends.
cc_backend_optimization_level=3

# The `cc` and `multidev_cc` backends compiler executable name.
# By default, `ocamlc -config` field `c_compiler` is used.
cc_backend_compiler_command=

# Additional architecture-specific flags for the CC backend compiler invocation.
# Default `-march=native` targets the host CPU. Override for portability/cross-compilation.
# To disable arch-specific tuning from commandline, pass `--ocannl_cc_backend_arch_flags=`.
cc_backend_arch_flags=-march=native

# Explicit SIMD flags appended to the CC backend compiler invocation (gh-ocannl-164).
# The default "auto" probes once per process: if the target selected by cc_backend_arch_flags
# already has AVX2 and FMA, `-mavx2 -mfma -ftree-vectorize` (or the subset the compiler accepts)
# is appended; otherwise (non-AVX2 x86, ARM) nothing is, so generated code never requires an ISA
# beyond the configured target. Any other value is passed through verbatim; empty disables.
cc_backend_simd_flags=auto

# If true, enables `-ffast-math` for the CC backend. This may change numerical behavior.
cc_backend_fast_math=false

# If true, compiled dynamic libraries (.dll/.so files) for the CC backend are placed 
# in the build_files directory using the source file path. If false, temporary files
# are used for the dynamic libraries (default behavior).
output_dlls_in_build_directory=false

# Per-tensor-node cutoff in bytes for considering off-stack allocation, opt-in for backends.
# Decrease it if you see crashes like `bus error`. Values smaller-or-equal 0 mean "no limits".
# Tensors exceeding this size will be allocated on the device's global memory.
stack_threshold_in_bytes=16384

# Only tensor nodes with up to this many visits per array cell (in a dedicated interpreter)
# can be inlined. Values worth considering: 0 (disables inlining) to 3.
virtualize_max_visits=1

# Recompute-cost cap for inlining: a tensor node whose computation contains reduction loops
# (loops enclosing a setter without appearing in its indices) with a total trip-count product
# exceeding this value is never virtualized, because inlining would replay the reduction at
# every read site (multiplying through chains of virtual consumers). Negative values disable
# the cap.
virtualize_max_inline_reduction=16

# Truncate longer axes to this many dimensions in the generic optimizer's interpreter.
virtualize_max_tracing_dim=5

# If `true`, tensor nodes will by default not be hosted.
enable_device_only=true

# If true, scalar constant expressions will always be inlined.
inline_scalar_constexprs=true

# If true, if the tensor node is built from either single getters, or index embeddings and
# scalar constant expressions, regardless of accesses, it will be inlined.
inline_simple_computations=true

# If true, virtualize_max_visits only counts accesses that are not used for assignment of
# the same cell (typically accumulation). Otherwise, all accesses are counted, so computations
# that reduce an axis will rarely be inlined.
inline_complex_computations=true

# Low-level-code identifier syntax. Options: heuristic, name_and_label, name_only.
ll_ident_style=heuristic

# Computation DSL identifier syntax. Options: heuristic, name_and_label, name_only.
cd_ident_style=heuristic

# For ppx_minidebug non-flushing static backends, when non-empty, enables snapshotting of ongoing
# logging into a file, with the given frequency.
snapshot_every_sec=

# Whether ppx_minidebug entries should be tagged by time information.
# Options: not_tagged, clock, elapsed (relative to start of the program).
time_tagged=elapsed

# Whether ppx_minidebug should print the time span of each entry, and in what units.
# Options: not_reported, seconds, milliseconds, microseconds, nanoseconds.
elapsed_times=not_reported

# For ppx_minidebug, how file locations should be presented. Options:
# no_location, file_only, beg_line, beg_pos, range_line, range_pos.
location_format=beg_pos

# The ppx_minidebug logging backend (i.e. format). Options: db, text, html, markdown, flushing.
# The db backend requires a rendering client from ppx_minidebug, the other backends
# generate static (rendered) artifacts.
debug_backend=db

# For ppx_minidebug: a prefix for file positions relative to the project root.
# A more elaborate example:
# hyperlink_prefix=vscode://file//wsl.localhost/ubuntu-24.04/home/lukstafi/ocannl/
hyperlink_prefix=./

# For ppx_minidebug: whether to print IDs for log entries.
logs_print_scope_ids=false

# For ppx_minidebug.
logs_verbose_scope_ids=false

# For ppx_minidebug, whether logging from the main domain, `Domain.is_main ()`,
# should be directed to stdout rather than to a file.
log_main_domain_to_stdout=false

# For ppx_minidebug Table of Contents.
toc_entry_minimal_depth=
toc_entry_minimal_size=
# The span is expressed in units: ns, us or ms.
toc_entry_minimal_span=

# For ppx_minidebug: `|`-separated list of terms to highlight in the logs.
debug_highlights=

# For ppx_minidebug: a pcre syntax regular expression to highlight in the logs.
debug_highlight_pcre=

# For ppx_minidebug: if provided, enables highlighting differences between the current run
# and a previous run loaded from `.raw` files derived using the given prefix.
prev_run_prefix=

# For ppx_minidebug: a pcre syntax regular expression pattern that will be removed from messages
# before comparison when highlighting differences between runs, allowing certain differences to be ignored.
diff_ignore_pattern_pcre=

# If not empty, should be a number giving the depth till which non-highlighted ppx_minidebug
# logs are pruned. Useful when enabling logging (e.g. shape inference) for non-toy examples.
debug_log_prune_upto=

# For ppx_minidebug: (minimal) width of the search band for the minimal edit distance algorithm.
diff_max_distance_factor=

# For ppx_minidebug: semicolon-separated list of comma-separated entry IDs from
# the previous and current run, that should be considered the same by the diffing algorithm.
debug_scope_id_pairs=

# For ppx_minidebug: for generating file names. If empty, all logging will be done to stdout,
# regardless of the value of `log_main_domain_to_stdout`.
log_file_stem=debug

# For ppx_minidebug: If given a number, sets the `truncate_children` parameter: only this number
# of the most recent children of each log entry are held.`
debug_log_truncate_children=

# It is useful for testing to have outputs more uniform across backends even if that criples
# some backends. Currently, this setting only affects logging from routines to accomodate Metal's
# shortcoming.
prefer_backend_uniformity=false

# The initial value for the default precisions for tensors. The default precisions for values and
# gradients can be changed separately via the `Tensor` API.
default_prec=single

# Numerics policy: allow tensor-core matmuls over uniform-f32 operands to compute in tf32
# (f32's exponent range, 10-bit mantissa, f32 accumulation) on backends with a tf32 tile shape
# (CUDA sm_80+). Off by default because enabling it silently changes numerics (PyTorch-style
# opt-in). Metal (genuine f32 simdgroup tiles) and HIP (no tf32-like shape) are unaffected.
# Programmatic override: `Ir.Numerics.set_policy`.
tf32_matmuls=false

# Limit on the allowed size of unrolled constant tensor nodes
# (where the initialization code sets the values).
limit_constant_fill_size=16

# The timeout for the CC backend to wait for the compilation files to appear, in seconds.
# This is the wait after the compiler command exits (doesn't include the compilation time).
cc_backend_post_compile_timeout=10.0

# If true, the CC backend will fail if the codesign of the compiled dynamic library fails.
cc_backend_verify_codesign=false

# The maximal number of entries for the provenance of constraints, as for example reported
# in shape error exceptions.
max_shape_error_origins=20
