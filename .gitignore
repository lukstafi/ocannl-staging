# ocamlbuild working directory
_build/

# ocamlbuild targets
*.byte
*.native

# oasis generated files
setup.data
setup.log

# Merlin configuring file for Vim and Emacs
.merlin

# Dune generated files
*.install

# Written per worktree by scripts/setup-ocaml-env.sh, never committed: dune roots
# at the OUTERMOST ancestor holding a dune-workspace, so a tracked copy at the repo
# root would shadow the one each nested .claude/worktrees/ checkout needs and pin
# every worktree's builds back to the main checkout.
dune-workspace

# Local OPAM switch
_opam/
.vscode/settings.json

# Local configuration
ocannl_config
!arrayjit/test/ocannl_config
!test/ocannl_config
!test/config/ocannl_config
!test/operations/profiles/ocannl_config
# Convenience for storing particular configurations, not used by OCANNL
ocannl_config-*

# Debug output
log_files/
build_files/

# Autotune schedule caches: the default cache dir (autotune_cache_dir) plus the
# per-test dirs named at the tests' Autotune.tune ~cache_dir call sites (they appear
# here only when a test exe is run from the repo root by hand; under dune runtest the
# cwd is inside _build/).
# Root-anchored: same-named dirs under test/config/ hold tracked fixtures, and an
# unanchored pattern would silently ignore a fixture regenerated under a new digest.
/autotune_cache/
/autotune_cache_serial_baseline/
/autotune_cache_test/
/autotune_fission_cache/
/autotune_fission_cache2/
/autotune_sketch_cache/
/autotune_split_cache/
/autotune_arm_containment_cache/
/conv_tune_cache/
/conv_tune_cache_aligned/
/conv_tune_cache_blocked/
/conv_tune_cache_gpu/
/conv_tune_cache_merged_blocked/
/epilogue_tune_cache/
/mma_companion_cache/
/symbolic_extent_tune_cache/

# Test artifacts written to the working directory
# (test/operations/test_safetensors.ml, test/training/tokenizer_roundtrip.ml).
/mini_tokenizer.json

# Model checkpoints are always generated or downloaded, never committed
# (benchmarks/.gitignore likewise excludes the generated fixtures/ dir).
*.safetensors

# LaTeX build artifacts
*.aux
*.log
*.out

# AI interaction files
.specstory/
.qodo
# LaTeX build artifacts
docs/*.fdb_latexmk
docs/*.fls
docs/*.aux
docs/*.log
docs/*.out
docs/*.bbl
docs/*.blg
.DS_Store

# Claude Code: share project settings and skills; everything else under .claude is local.
/.claude/*
!/.claude/settings.json
!/.claude/skills/
