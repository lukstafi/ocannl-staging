; Three support libraries, deliberately split by dependency (gh-ocannl-600). [verdict] depends on
; nothing but base and stdio, and belongs to the `arrayjit` package rather than to
; `neural_nets_lib`: the arrayjit tests report verdicts too, and arrayjit cannot depend on the
; package that depends on it (gh-ocannl-601). [test_utils] stays on [arrayjit.ir] alone, because
; tests like config_scan_lexing and test_ndarray link nothing more; [ll_test] links [ocannl], for
; the hand-built-Low_level harness.

(library
 (name verdict)
 (package arrayjit)
 (modules verdict)
 (libraries base stdio))

(library
 (name test_utils)
 (package neural_nets_lib)
 (modules test_utils config_key_scan dune_stanza_scan)
 (libraries base stdio arrayjit.ir compiler-libs.common sexplib))

(library
 (name ll_test)
 (package neural_nets_lib)
 (modules ll_test)
 (libraries base stdio ocannl verdict))
