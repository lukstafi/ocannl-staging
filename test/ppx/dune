(copy_files
 (files ../config/ocannl_config))

; The ambient-environment gate (gh-ocannl-652). `(universe)` makes dune rerun it on every
; invocation, which is the only way a rejected environment spelling reaches a check at all:
; every other rule here is cached against declarations that no longer name those spellings,
; so `ocannl_backend=cuda dune build @test/ppx/runtest` would otherwise serve this
; directory's previous run wholesale. One per test directory, because dune aliases are per
; directory; the source is shared, and its header says why the dependency is the world
; rather than 112 key names.

(copy_files
 (files ../config/env_spelling_gate.ml))

(test
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (name env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

(executable
 (name pp)
 (public_name pp)
 (package neural_nets_lib)
 (modules pp)
 (libraries ppx_ocannl ppxlib)
 (modes exe))

(rule
 ; ocannl-backend: none -- pp.exe links ppx_ocannl, which is base, ppxlib, str and einsum_parser:
 ; no arrayjit at all, so no OCANNL configuration is in reach. Its output is a printed AST.
 (targets test_ppx_op_actual.ml)
 (package neural_nets_lib)
 (deps
  (:pp pp.exe)
  (:input test_ppx_op.ml))
 (action
  (run ./%{pp} --impl %{input} -o %{targets})))

(rule
 ; ocannl-backend: none -- pp.exe links ppx_ocannl, which is base, ppxlib, str and einsum_parser:
 ; no arrayjit at all, so no OCANNL configuration is in reach. Its output is a printed AST.
 (targets test_ppx_name_conflict_actual.ml)
 (package neural_nets_lib)
 (deps
  (:pp pp.exe)
  (:input test_ppx_name_conflict.ml))
 (action
  (run ./%{pp} --impl %{input} -o %{targets})))

(rule
 ; ocannl-backend: none -- pp.exe links ppx_ocannl, which is base, ppxlib, str and einsum_parser:
 ; no arrayjit at all, so no OCANNL configuration is in reach. Its output is a printed AST.
 (targets test_compose_logic_err_actual.ml)
 (package neural_nets_lib)
 (deps
  (:pp pp.exe)
  (:input test_compose_logic_err.ml))
 (action
  (run ./%{pp} --impl %{input} -o %{targets})))

(rule
 (alias runtest)
 (package neural_nets_lib)
 (action
  (diff test_ppx_op_expected.ml test_ppx_op_actual.ml)))

(rule
 (alias runtest)
 (package neural_nets_lib)
 (action
  (diff test_ppx_name_conflict_expected.ml test_ppx_name_conflict_actual.ml)))

(rule
 (alias runtest)
 (package neural_nets_lib)
 (action
  (diff test_compose_logic_err_expected.ml test_compose_logic_err_actual.ml)))

(test
 (name test_ppx_op)
 (package neural_nets_lib)
 (modules test_ppx_op)
 (deps
  ocannl_config
  (env_var OCANNL_BACKEND))
 (libraries ocannl)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(test
 (name test_ppx_op_expected)
 (package neural_nets_lib)
 (modules test_ppx_op_expected)
 (deps
  ocannl_config
  (env_var OCANNL_BACKEND))
 (libraries ocannl))
