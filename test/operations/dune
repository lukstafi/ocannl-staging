; gh-ocannl-533: the HIP scratch pre-validator. Gated behind `slow`: meaningful only on HIP, and it
; deliberately compiles a kernel with a ~128 KiB per-work-item stack frame. `no-infer` keeps the
; .actual out of the build targets so a plain `dune build` does not run it.

(executable
 (name hip_scratch_budget)
 (modules hip_scratch_budget)
 (libraries base ocannl stdio)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(rule
 (alias slow)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  hip_scratch_budget.expected
  ocannl_config
  (env_var OCANNL_BACKEND))
 (action
  (no-infer
   (progn
    (with-stdout-to
     hip_scratch_budget.actual
     (run %{dep:hip_scratch_budget.exe}))
    (diff hip_scratch_budget.expected hip_scratch_budget.actual)))))

; gh-ocannl-533, the containment half: a declined baseline must not end the search. Same gating as
; above — HIP-meaningful, and it runs a (small) autotune search.

(executable
 (name hip_scratch_tune_survives)
 (modules hip_scratch_tune_survives)
 (libraries base ocannl stdio)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(rule
 (alias slow)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  hip_scratch_tune_survives.expected
  ocannl_config
  (env_var OCANNL_BACKEND))
 (action
  (no-infer
   (progn
    (with-stdout-to
     hip_scratch_tune_survives.actual
     (run %{dep:hip_scratch_tune_survives.exe}))
    (diff hip_scratch_tune_survives.expected hip_scratch_tune_survives.actual)))))
