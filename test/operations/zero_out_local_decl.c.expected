
#include <stdio.h>
#include <math.h>
#include <stdint.h>
#include <string.h>
#include <stdlib.h>

/* SIMD platform detection (gh-ocannl-164): compile-time macros for conditional SIMD code paths
   (explicit intrinsics are emitted by follow-up work; auto-vectorization needs no guards). */
#ifdef __AVX2__
  #define OCANNL_HAS_AVX2 1
  #include <immintrin.h>
#else
  #define OCANNL_HAS_AVX2 0
#endif
#ifdef __ARM_NEON
  #define OCANNL_HAS_NEON 1
  #include <arm_neon.h>
#else
  #define OCANNL_HAS_NEON 0
#endif

/* No longer need export macros since we're using textual prepending */

 void out_fwd(
    float *restrict out) {

  /* Local declarations and initialization. */
  float sparse[12] __attribute__((aligned(32))) = {0};

  /* Main logic. */
  /* out fwd */
  for (int32_t i7 = 0; i7 <= 3; ++i7) {
    sparse[(i7) * 3 + 0] = (float)(i7);
  }
  for (int32_t i10 = 0; i10 <= 3; ++i10) {
    out[i10] = (sparse[(i10) * 3 + 2] * sparse[(i10) * 3 + 2]);
  }
  /* end */
}