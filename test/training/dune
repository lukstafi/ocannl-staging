(copy_files
 (files ../config/ocannl_config))

; The ambient-environment gate (gh-ocannl-652). `(universe)` makes dune rerun it on every
; invocation, which is the only way a rejected environment spelling reaches a check at all:
; every other rule here is cached against declarations that no longer name those spellings,
; so `ocannl_backend=cuda dune build @test/training/runtest` would otherwise serve this
; directory's previous run wholesale. One per test directory, because dune aliases are per
; directory; the source is shared, and its header says why the dependency is the world
; rather than 112 key names.
;
; Takes `ocannl_training_test` like every other action in this file. Not for contention of its
; own -- the gate links `arrayjit.utils` and starts no OpenMP pool, so the reason the lock exists
; does not reach it -- but because an unlocked action here is a trap for whoever copies the
; nearest stanza to write a real training test (Codex P1 round 4). It holds the lock for the
; microseconds it takes to read the environment.

(copy_files
 (files ../config/env_spelling_gate.ml))

(test
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (name env_spelling_gate)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps ocannl_config (universe))
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

; The same gate for the `slow` suite, which is a separate entry point: `dune build @slow` builds no
; `(test)` stanza, so without this rule a cached `@slow` run would serve every slow result with a
; rejected spelling ambient (Codex P1 round 3). Runs the executable the `(test)` stanza above
; builds, so there is one gate binary per directory however many aliases reach it. It sits on an
; alias of its own so that every slow rule can DEPEND on it: `dune build @<dir>/slow-<name>` then
; runs the gate first and that one test after it, and the `slow` alias below aggregates them all.

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (alias slow-env_spelling_gate)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; The same gate for the per-test `runtest-<name>` aliases (gh-ocannl-703, gh-ocannl-726). A rule
; that diffs a golden sits on an alias of its own, so that ONE of them can be rerun targeted --
; `dune build @test/training/runtest-transformer_names` -- and a per-test alias is a build entry
; point like any other, so the ambient gate has to reach it. It sits on an alias of its own that
; every such rule DEPENDS on, which runs the gate BEFORE the diff -- the same shape the slow rules
; use. The name is the one dune >= 3.20 generates for the `env_spelling_gate` `(test)` stanza above:
; a rule may add an action to a generated per-test alias, and this one runs the same gate binary, so
; the alias means the same thing whichever dune is building.

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (alias runtest-env_spelling_gate)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; This directory's golden-diff rules, aggregated back onto `runtest` (gh-ocannl-726). Each of them
; attaches to its own `runtest-<name>` alias and to NOTHING else, so that `dune build
; @test/training/runtest-transformer_names` runs that one test and applies its diff; this stanza is
; what keeps `dune runtest` running them. Attaching such a rule to `runtest` as well would defeat
; the point: a rule on two aliases makes building either alias build both, so a per-test alias that
; also named `runtest` would pull the whole directory in behind it. A `runtest-<name>` rule missing
; from this list is one plain `dune runtest` skips silently, which `test/operations/env_var_deps`
; checks -- the same check it makes of the `slow` suite.

(alias
 (name runtest)
 (deps
  (alias runtest-transformer_names)))

; The resolved backend name, for the per-backend goldens below (the gh-ocannl-700 shape, as in
; `test/operations/micrograd_demo_logging-<backend>-0-0.log.expected`). Reads the same configuration
; the run itself will read -- config file, environment, command line -- and normalizes the
; deprecated aliases, so `OCANNL_BACKEND=multicore_cc` names the `multidev_cc` golden.

(rule
 (target ocannl_backend.txt)
 (package neural_nets_lib)
 (deps
  ocannl_config
  (env_var OCANNL_BACKEND))
 (action
  (run %{bin:ocannl_read_config} "--read=backend")))

; This directory's `slow` suite. Each slow rule attaches to its own `slow-<name>` alias, so that
; ONE slow test can be rerun after a change -- `OCANNL_BACKEND=cc dune build
; @test/training/slow-mlp_names` -- without rebuilding the whole `@slow` suite; this stanza is what
; makes `dune build @slow` still run all of them. A `slow-<name>` rule missing from this list is one
; `@slow` silently skips, which `test/operations/env_var_deps` checks.

(alias
 (name slow)
 (deps
  (alias slow-env_spelling_gate)
  (alias slow-mlp_names)
  (alias slow-mlp_bn_names)
  (alias slow-mnist_conv)
  (alias slow-cifar_conv)))

; Training executables can each saturate the CPU through the cc backend's process-local OpenMP
; pool. Serialize their actions by default: concurrent pools oversubscribe non-macOS hosts badly,
; while compilation and tests outside this directory remain parallel.

(test
 ; ocannl-backend: cc,multidev_cc -- every entry point names its backend,
 ; `Parallel.data_parallel ~backend_name:"cc"` or `"multidev_cc"`, so get_backend never falls
 ; through to the configured one. Dropping a `~backend_name` here would make it selecting.
 (name data_parallel)
 (package neural_nets_lib)
 (modules data_parallel)
 (locks ocannl_training_test)
 (deps ocannl_config)
 (libraries base ocannl stdio arrayjit.utils arrayjit.verdict)
 (preprocess
  (pps ppx_here ppx_ocannl)))

