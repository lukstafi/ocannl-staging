; mlp_names is a slow training run: gated behind the `slow` alias (see cifar_conv).

(executable
 (name mlp_names)
 (modules mlp_names)
 (libraries ocannl dataprep arrayjit.verdict)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(rule
 (alias slow-mlp_names)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  (alias slow-env_spelling_gate)
  mlp_names.expected
  ocannl_config
  (env_var OCANNL_BACKEND))
 ; no-infer keeps mlp_names.actual from becoming a build target, so plain
 ; `dune build` (@all) does not run this slow exe -- only `@slow` and `@slow-mlp_names` do.
 (action
  (no-infer
   (progn
    (with-stdout-to
     mlp_names.actual
     (run %{dep:mlp_names.exe}))
    (diff mlp_names.expected mlp_names.actual)))))

