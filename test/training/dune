; circles_conv is a training integration run: in the default runtest suite since its sgd step
; is autotuned (materialized intermediates + Autotune.tune), and the loss accumulates on device
; (Train.grad_update ?accum_loss) so the loop syncs once per epoch. NOTE: ~27s on cc, ~60s on
; the metal backend with a fresh tune cache (batch 32 / 5k steps: the remaining metal cost is
; GPU execution of the fissioned step's ~40 serialized dispatches).

(test
 (name circles_conv)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  ocannl_config
  (env_var OCANNL_BACKEND))
 (modules circles_conv)
 (libraries ocannl dataprep)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(library
 (name conv_data)
 (package neural_nets_lib)
 (modules conv_data)
 (libraries unix))

