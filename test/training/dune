; transformer_names is a transformer training integration run: in the default runtest suite since
; its sgd step is autotuned (materialized intermediates + Autotune.tune), the whole one-hot
; dataset lives on device (batches via @| batch_n — no per-step host transfers), and the loss
; accumulates on device so the loop syncs once per epoch. NOTE: ~10s on cc, ~36s on the metal
; backend with a fresh tune cache (batch 128 / 2.5k steps).
;
; Its golden is PER BACKEND (gh-ocannl-787, the gh-ocannl-700 shape), which is why this is an
; `(executable)` plus a diff rule rather than a `(test)` stanza: a `(test)` can only diff the one
; `<name>.expected` beside it. The three sampled names at the end of the run are the human-legible
; canary that the model learned name structure -- the loss thresholds are their quantitative proxy,
; not their replacement -- and they are exact by construction only PER SCHEDULER: `Multidev` is free
; to differ from `Sync` in execution order and device split, so its training trajectory and the
; sampling RNG state legitimately diverge and no single promotion serves both. Recorded on this
; repository's reference Mac for cc, multidev_cc and metal; the cuda and hip goldens carry the
; previously shared golden verbatim, which is the content they were passing against in the daily
; sweep. Re-record one with `OCANNL_BACKEND=<b> dune build @test/training/runtest-transformer_names`
; and `dune promote`.

(executable
 (name transformer_names)
 (modules transformer_names)
 (libraries ocannl dataprep arrayjit.verdict)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(rule
 (alias runtest-transformer_names)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  (alias runtest-env_spelling_gate)
  "transformer_names-%{read:ocannl_backend.txt}.expected"
  ocannl_config
  (env_var OCANNL_BACKEND))
 ; no-infer keeps transformer_names.actual from becoming a build target, so plain `dune build`
 ; (@all) does not run this training exe -- only `@runtest` and `@runtest-transformer_names` do,
 ; which is what the `(test)` stanza this replaced gave for free.
 (action
  (no-infer
   (progn
    (with-stdout-to
     transformer_names.actual
     (run %{dep:transformer_names.exe}))
    (diff
     "transformer_names-%{read:ocannl_backend.txt}.expected"
     transformer_names.actual)))))

