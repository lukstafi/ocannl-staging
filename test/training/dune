; circles_conv is a training integration run: in the default runtest suite since its sgd step
; is autotuned (materialized intermediates + Autotune.tune). NOTE: ~28s on cc, ~7min on the
; metal backend with a fresh tune cache (20k steps; aligned cross-nest parallelism merges the
; pointwise chains — the remaining gap is launch/event overhead of the segments genuine
; parallelism switches still force).

(test
 (name circles_conv)
 (package neural_nets_lib)
 (deps
  ocannl_config
  (env_var OCANNL_BACKEND))
 (modules circles_conv)
 (libraries ocannl dataprep)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(library
 (name conv_data)
 (package neural_nets_lib)
 (modules conv_data)
 (libraries unix))

